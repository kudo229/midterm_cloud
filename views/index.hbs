{{#if error}}
<div class="alert alert-danger alert-dismissible fade show" role="alert">
    {{error}}
</div>
{{/if}}

{{#if success}}
<div class="alert alert-success alert-dismissible fade show" role="alert">
    {{success}}
</div>
{{/if}}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="card-title mb-0">Thêm Sách Mới</h5>
    </div>
    <div class="card-body">
        <form action="/books" method="POST">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Mã Sách (*)</label>
                    <input type="text" name="bookCode" class="form-control" placeholder="VD: 184-B01" required>
                    <div class="form-text text-danger">Tiền tố bắt buộc: <strong>184</strong></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Tên Sách</label>
                    <input type="text" name="title" class="form-control" placeholder="Nhập tên sách..." required>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Giá gốc (VNĐ)</label>
                    <input type="number" name="basePrice" class="form-control" placeholder="Giá chưa thuế" min="0"
                        required>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Thêm mới</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="card-title mb-0">Danh Sách Sách Trong Hệ Thống</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã Sách</th>
                    <th>Tên Sách</th>
                    <th>Giá gốc</th>
                    <th>Thuế VAT</th>
                    <th>Giá sau thuế (Cloud Saved)</th>
                </tr>
            </thead>
            <tbody>
                {{#each books}}
                <tr>
                    <td><span class="badge bg-secondary">{{this.bookCode}}</span></td>
                    <td><strong>{{this.title}}</strong></td>
                    <td>{{this.basePrice}} đ</td>
                    <td>{{this.vatRate}}%</td>
                    <td class="text-danger fw-bold">{{this.finalPrice}} đ</td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">Chưa có dữ liệu sách</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>